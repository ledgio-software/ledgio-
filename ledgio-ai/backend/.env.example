# Ledgio AI — Environment Variables
# Copy this to .env and fill in real values. Never commit .env.

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string for the main Ledgio database
DATABASE_URL=postgresql://user:password@localhost:5432/ledgio

# Port for this service (default 4000)
AI_PORT=4000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://app.ledgio.com

# JWT public key for verifying tokens from the main Ledgio auth service
# LEDGIO_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
